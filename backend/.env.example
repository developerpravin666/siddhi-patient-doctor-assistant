# ==============================================================================
# Siddhi Patient-Doctor Assistant - Backend Environment Configuration
# ==============================================================================

ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Google Gemini API Configuration
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_ACCESS_TOKEN=EAAB...YourPermanentOrTemporaryToken
WHATSAPP_VERIFY_TOKEN=siddhi_patient_assistant_verify_token_secure_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_API_VERSION=v21.0

# Redis (Session Memory & Rate Limiting)
REDIS_URL=redis://localhost:6379/0
SESSION_EXPIRY_SECONDS=1800

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Production PostgreSQL Connection String (Standard or Async):
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/siddhi_db

# Standard PostgreSQL URI (auto-converted to asyncpg by the application):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/s_clinic?sslmode=require

# Or discrete parameters (auto-assembled if provided):
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=siddhi123456
# POSTGRES_DB=s_clinic
# POSTGRES_SSLMODE=prefer

# For local offline SQLite testing:
# DATABASE_URL=sqlite+aiosqlite:///./siddhi_assistant.db

# Database Connection Pool Settings (Product-Grade)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Scheduler & Notifications
REMINDER_CHECK_INTERVAL_SECONDS=60
DEFAULT_CLINIC_TIMEZONE=Asia/Kolkata

# Admin JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
