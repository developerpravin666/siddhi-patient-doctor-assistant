# =============================================================================
# SINGLE SOURCE OF TRUTH FOR BACKEND API URL
# =============================================================================
# Change this ONE line whenever your backend location changes.
# Both Axios client (API calls) and Vite dev server proxy automatically sync to it.
#
# Examples:
#   Local Backend:             VITE_API_BASE_URL=http://localhost:8000
#   Cloudflare Tunnel:         VITE_API_BASE_URL=https://your-tunnel.trycloudflare.com
#   Production API Domain:     VITE_API_BASE_URL=https://api.yourclinic.com
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000
