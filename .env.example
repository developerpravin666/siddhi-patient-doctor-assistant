# ==============================================================================
# Siddhi Patient-Doctor Assistant - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI API CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. META WHATSAPP CLOUD API CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from Meta for Developers: https://developers.facebook.com/apps
# Meta App -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_ACCESS_TOKEN=EAAB...YourPermanentOrTemporaryToken
# The secret verify token you set in Meta App -> Configuration -> Edit Webhook
WHATSAPP_VERIFY_TOKEN=siddhi_patient_assistant_verify_token_secure_2026
# App Secret from App Settings -> Basic (used to verify X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 4. REDIS (SESSION MEMORY & RATE LIMITING)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
SESSION_EXPIRY_SECONDS=1800

# ------------------------------------------------------------------------------
# 5. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite / PostgreSQL / MongoDB
DATABASE_URL=sqlite+aiosqlite:///./siddhi_assistant.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/siddhi_db

# ------------------------------------------------------------------------------
# 6. SCHEDULER & NOTIFICATIONS
# ------------------------------------------------------------------------------
REMINDER_CHECK_INTERVAL_SECONDS=60
DEFAULT_CLINIC_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 7. ADMIN JWT AUTHENTICATION (For React Frontend)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

TEST_KEY=test_key